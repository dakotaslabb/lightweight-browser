{
  "name": "lightweight-browser",
  "version": "1.0.0",
  "description": "A minimalist, lightweight web browser with proxy navigation and bookmark storage",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lightbrowser.app",
    "productName": "Light Browser",
    "files": [
      "server.js",
      "electron-main.js",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
